# Optional Spotify catalogue search.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=KZ

# Optional cloud analysis of the text and resized photos with Google Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional Google Photos Picker (Web application OAuth client ID).
GOOGLE_PHOTOS_CLIENT_ID=

# Local owner entry point.
DAYTRACE_HOST=127.0.0.1
PORT=4173
